// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String       @id @default(uuid())
  userName     String       @unique
  email        String       @unique
  password     String?
  avatar       String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  isOnline     Boolean      @default(false)
  lastSeen     DateTime     @default(now())
  status       UserStatus   @default(ACTIVE)
  platformRole PlatformRole @default(USER)

  // Relations
  sentMessages         Message[]          @relation("MessageSender")
  roomMemberships      RoomMember[]
  workspaceMemberships WorkspaceMember[]
  invitationTokens     InvitationToken[]
  createdImportJobs    ImportJob[]        @relation("ImportJobCreator")
  notifications        Notification[]     @relation("NotificationRecipient")
  uploadedAttachments  Attachment[]       @relation("AttachmentUploader")

  @@map("users")
}

model Workspace {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members          WorkspaceMember[]
  rooms            Room[]
  invitationTokens InvitationToken[]
  importJobs       ImportJob[]
  notifications    Notification[]

  @@map("workspaces")
}

model ImportJob {
  id                 String          @id @default(uuid())
  workspaceId        String
  createdById        String
  status             ImportJobStatus @default(PENDING)
  dryRun             Boolean         @default(false)
  fileName           String?
  totalRows          Int             @default(0)
  validRows          Int             @default(0)
  errorRows          Int             @default(0)
  invitationsCreated Int             @default(0)
  emailsSent         Int             @default(0)
  emailsFailed       Int             @default(0)
  result             Json?
  error              String?
  startedAt          DateTime?
  completedAt        DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User      @relation("ImportJobCreator", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([createdById])
  @@map("import_jobs")
}

model WorkspaceMember {
  id          String                @id @default(uuid())
  workspaceId String
  userId      String
  role        WorkspaceRole         @default(MEMBER)
  status      WorkspaceMemberStatus @default(ACTIVE)
  joinedAt    DateTime              @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@map("workspace_members")
}

model InvitationToken {
  id          String    @id @default(uuid())
  token       String    @unique
  userId      String
  workspaceId String
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([workspaceId])
  @@map("invitation_tokens")
}

model Message {
  id        String      @id @default(uuid())
  content   String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  type      MessageType @default(TEXT)

  // Relations
  senderId String
  sender   User   @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  roomId String
  room   Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)
  attachments Attachment[]

  // Métadonnées
  editedAt  DateTime?
  isDeleted Boolean   @default(false)

  @@index([roomId, createdAt])
  @@index([senderId])
  @@map("messages")
}

model Notification {
  id          String           @id @default(uuid())
  recipientId String
  workspaceId String?
  type        NotificationType
  title       String
  body        String
  metadata    Json?
  readAt      DateTime?
  createdAt   DateTime         @default(now())

  recipient User       @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([recipientId, readAt, createdAt])
  @@index([workspaceId])
  @@map("notifications")
}

model Attachment {
  id           String           @id @default(uuid())
  key          String           @unique
  url          String?
  fileName     String
  mimeType     String
  size         Int
  kind         AttachmentKind
  status       AttachmentStatus @default(PENDING)
  durationMs   Int?
  uploadedById String
  messageId    String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  uploadedBy User     @relation("AttachmentUploader", fields: [uploadedById], references: [id], onDelete: Cascade)
  message    Message? @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@index([uploadedById, status])
  @@index([messageId])
  @@map("attachments")
}

model Room {
  id          String   @id @default(uuid())
  name        String
  description String?
  isPrivate   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Métadonnées
  maxMembers Int     @default(100)
  isActive   Boolean @default(true)

  // Relations
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  messages    Message[]
  members     RoomMember[]

  // Room privée (DM) entre 2 users
  isDirectMessage Boolean @default(false)

  @@index([isActive])
  @@index([workspaceId])
  @@map("rooms")
}

model RoomMember {
  id       String   @id @default(uuid())
  joinedAt DateTime @default(now())
  role     RoomRole @default(MEMBER)
  isActive Boolean  @default(true)

  // Relations
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  roomId String
  room   Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([userId, roomId])
  @@map("room_members")
}

// Enums
enum UserStatus {
  ACTIVE
  INACTIVE
  BANNED
  SUSPENDED
}

enum PlatformRole {
  SUPER_ADMIN
  USER
}

enum MessageType {
  TEXT
  IMAGE
  FILE
  AUDIO
  SYSTEM // Messages automatiques (join, leave, etc.)
}

enum RoomRole {
  OWNER
  ADMIN
  MODERATOR
  MEMBER
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}

enum WorkspaceMemberStatus {
  ACTIVE
  INVITED
  DISABLED
}

enum ImportJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum NotificationType {
  USER_INVITED
  ROOM_MEMBER_ADDED
  ROOM_MEMBER_REMOVED
  IMPORT_COMPLETED
  IMPORT_FAILED
  DM_MESSAGE
}

enum AttachmentKind {
  IMAGE
  DOCUMENT
  AUDIO
}

enum AttachmentStatus {
  PENDING
  ATTACHED
}
